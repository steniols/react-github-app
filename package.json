{
  "name": "github-app-api",
  "version": "2.0.0",
  "description": "A simple GitHub application study with Postgres, Express, React and Node.",
  "main": "server.js",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "concurrently -n api,client -c blue,green \"nodemon server.js\" \"npm --prefix client run dev\"",
    "db": "node scripts/db.js",
    "migrate": "knex migrate:latest",
    "setup": "npm install && npm --prefix client install",
    "build": "npm --prefix client run build",
    "heroku-postbuild": "npm --prefix client install && npm run build",
    "knex": "knex",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "author": "Stenio L. de Souza",
  "dependencies": {
    "axios": "^1.21.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.22.3",
    "knex": "^3.3.0",
    "morgan": "^1.12.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "embedded-postgres": "^18.6.0-beta.19",
    "nodemon": "^3.1.14"
  }
}
